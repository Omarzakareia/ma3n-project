<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="HospitalSystem.MasterPage" %>

<!doctype html>
<html lang="en">

<head>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;700&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link href="<%= ResolveUrl("~/Styles/style.css") %>" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="<%= ResolveUrl("~/img/favicon.png") %>">

    <title>DOCDOSE</title>
</head>

<body>
    <form id="form1" runat="server" class="w-100  overflow-auto">
        <telerik:RadScriptManager ID="RadScriptManager1" runat="server">
            <Scripts>
                <asp:ScriptReference Assembly="Telerik.Web.UI" Name="Telerik.Web.UI.Common.Core.js" />
                <asp:ScriptReference Assembly="Telerik.Web.UI" Name="Telerik.Web.UI.Common.jQuery.js" />
                <asp:ScriptReference Assembly="Telerik.Web.UI" Name="Telerik.Web.UI.Common.jQueryInclude.js" />
            </Scripts>
        </telerik:RadScriptManager>

        <telerik:RadAjaxManager ID="RadAjaxManager1" runat="server"></telerik:RadAjaxManager>

        <!-- NAVBAR MOVED INSIDE THE FORM -->
        <!-- NAVBAR MOVED INSIDE THE FORM -->
        <nav class="navbar navbar-expand-lg p-3">
            <div class="container-fluid">
                <!-- Logo on the Left -->
                <a href="<%= ResolveUrl("~/Default.aspx") %>">
                    <img width="140" src="<%= ResolveUrl("~/img/logo.png") %>">
                </a>

                <!-- Hamburger Button for Mobile View -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                    <!-- Centered Navigation Links -->
                    <ul class="navbar-nav">
                        <!-- User Management (Admin Only) -->
                        <li class="nav-item" id="userManagementNav" runat="server">
                            <a href="<%= ResolveUrl("~/Users/UserManagement.aspx") %>">User Management</a>
                        </li>

                        <!-- Doctor Dropdown (Admin & Doctor) -->
                        <li class="nav-item dropdown" id="doctorsNav" runat="server">
                            <a class="dropdown-toggle" href="#" id="doctorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Doctor</a>
                            <ul class="dropdown-menu" aria-labelledby="doctorDropdown">
                                <li><a class="dropdown-item" href="<%= ResolveUrl("~/Doctors/Departments.aspx") %>">Departments</a></li>
                                <li><a class="dropdown-item" href="<%= ResolveUrl("~/Doctors/MyAppointments.aspx") %>">Appointments</a></li>
                            </ul>
                        </li>

                        <!-- Patients (Admin & Staff) -->
                        <li class="nav-item" id="patientsNav" runat="server">
                            <a href="<%= ResolveUrl("~/Patients/Patients.aspx") %>">Patients</a>
                        </li>
                    </ul>
                </div>

                <!-- Right Side: Login & Logout -->
                <div class="d-flex">
                    <ul class="navbar-nav">
                        <li class="nav-item" id="lstLog" runat="server">
                            <a class="btn btn-info text-white" href="<%= ResolveUrl("~/Login.aspx") %>">Login</a>
                        </li>
                        <li class="nav-item d-flex align-items-center" id="lstWelcome" runat="server">
                            <asp:LinkButton ID="btnUser" runat="server"></asp:LinkButton>
                            <asp:LinkButton ID="btnLogOut" CssClass="btn btn-danger ms-2" runat="server" OnClick="btnLogOut_Click">Sign Out</asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="page-container">
            <div id="content-wrap">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
        <footer class="footer">
            <div class="container">
                <div class="footer-content">
                    <!-- Logo Section -->
                    <div class="footer-logo-section">
                        <a href="index.html">
                            <img src="<%= ResolveUrl("~/img/logo.png") %>" class="footer-logo" alt="Logo">
                        </a>
                    </div>

                    <!-- Sitemap -->
                    <div class="footer-links-section mt-4">
                        <ul class="footer-links">
                            <li><a href="#">About Us</a></li>
                            <li><a href="#">Our Team</a></li>
                            <li><a href="#">Contact Us</a></li>
                        </ul>
                    </div>

                    <!-- Social Links -->
                    <div class="footer-social-section">
                        <h5>Follow Us</h5>
                        <ul class="footer-social">
                            <li><a href="#"><i class="bi bi-facebook"></i></a></li>
                            <li><a href="#"><i class="bi bi-instagram"></i></a></li>
                            <li><a href="#"><i class="bi bi-twitter"></i></a></li>
                            <li><a href="#"><i class="bi bi-linkedin"></i></a></li>
                        </ul>
                    </div>
                </div>

                <!-- Copyright -->
                <div class="footer-bottom">
                    <p>&copy; 2025 Your Hospital. All Rights Reserved.</p>
                </div>
            </div>
        </footer>

    </form>






    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous">
    </script>
</body>

</html>
